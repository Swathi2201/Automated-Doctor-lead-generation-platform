# ============================================================================
# AUTOMATED LEAD GENERATION - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED: OpenRouter API
# ============================================================================
# Sign up at: https://openrouter.ai/
# Get free credits for DeepSeek V3.1 (very cheap API)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================================================
# REQUIRED: LinkedIn Credentials (for LinkedIn automation)
# ============================================================================
# IMPORTANT: Use a burner/secondary LinkedIn account
# LinkedIn may flag automated activity
LINKEDIN_EMAIL=your_burner_email@gmail.com
LINKEDIN_PASSWORD=your_secure_password

# ============================================================================
# OPTIONAL: Twilio (for automated phone calls)
# ============================================================================
# Sign up at: https://www.twilio.com/
# Get free trial credits ($15-20)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE=+1234567890

# ============================================================================
# OPTIONAL: Hunter.io (for better email finding)
# ============================================================================
# Sign up at: https://hunter.io/
# Free tier: 25 requests/month
# HUNTER_API_KEY=your_hunter_api_key

# ============================================================================
# NOTES:
# ============================================================================
# 1. Never commit your .env file to version control
# 2. Keep your API keys secure
# 3. Use burner accounts for LinkedIn to avoid main account bans
# 4. Start with small test campaigns before scaling up
